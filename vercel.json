{
  "buildCommand": "npx vite build && mv dist/index.html dist/shell.html",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/api/render?path=/" },
    { "source": "/blog", "destination": "/api/render?path=/blog" },
    { "source": "/blog/:slug", "destination": "/api/render?path=/blog/:slug" },
    { "source": "/lactigo-australia", "destination": "/api/render?path=/lactigo-australia" },
    { "source": "/topical-carnosine-gel-australia", "destination": "/api/render?path=/topical-carnosine-gel-australia" },
    { "source": "/carnosine-gel-australia", "destination": "/api/render?path=/carnosine-gel-australia" },
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.png|logo\\.png|og-image\\.png).*)",
      "destination": "/shell.html"
    }
  ]
}
